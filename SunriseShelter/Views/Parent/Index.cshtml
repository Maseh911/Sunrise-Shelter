@model PaginatedList<SunriseShelter.Areas.Identity.Data.SunriseShelterUser>

@{
    ViewData["Title"] = "Registered Parents";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<style>
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        min-width: 100%;
    }

    .table th, .table td {
        padding: 12px 8px;
    }

    .actions-column {
        white-space: nowrap;
        min-width: 180px;
    }

    .btn-group .btn {
        white-space: nowrap;
        margin-right: 4px;
    }

    .text-truncate-cell {
        max-width: 150px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .card {
        width: 100%;
    }

    .sort-icon {
        margin-left: 5px;
        font-size: 0.9rem;
    }

    .sortable-header:hover {
        background-color: rgba(0, 0, 0, 0.05);
        border-radius: 4px;
        transition: background-color 0.2s ease;
    }
</style>

<div class="container mt-4">
    <h1 class="text-center mb-4">Registered Parents</h1>

    <!-- Search Bar -->
    <form asp-action="Index" method="get" class="d-flex justify-content-center mb-4">
        <div class="input-group shadow-sm" style="max-width: 600px;">
            <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]"
                   class="form-control border-start-0 rounded-end" placeholder="Find by name..." />
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-search"></i>
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center shadow-sm" role="alert">
            "@ViewData["CurrentFilter"]" was not found in the records.
        </div>
    }
    else
    {
        <!-- Table inside card -->
        <div class="card shadow-sm border-0 mx-auto" style="max-width: none;">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-start">
                            <tr>
                                <th style="min-width: 150px;">
                                    <a asp-action="Index"
                                       asp-route-sortOrder="@ViewData["NameSortParm"]"
                                       asp-route-currentFilter="@ViewData["CurrentFilter"]"
                                       asp-route-pageNumber="@Model.PageIndex"
                                       class="text-decoration-none text-dark fw-bold d-flex align-items-center sortable-header">
                                        First Name
                                        @if (ViewData["CurrentSort"]?.ToString() == "name_desc")
                                        {
                                            <i class="bi bi-sort-down-alt sort-icon"></i>
                                        }
                                        else if (ViewData["CurrentSort"]?.ToString() == "Name")
                                        {
                                            <i class="bi bi-sort-up-alt sort-icon"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-filter sort-icon"></i>
                                        }
                                    </a>
                                </th>
                                <th style="min-width: 150px;">
                                    <a asp-action="Index"
                                       asp-route-sortOrder="@ViewData["LastNameSortParm"]"
                                       asp-route-currentFilter="@ViewData["CurrentFilter"]"
                                       asp-route-pageNumber="@Model.PageIndex"
                                       class="text-decoration-none text-dark fw-bold d-flex align-items-center sortable-header">
                                        Last Name
                                        @if (ViewData["CurrentSort"]?.ToString() == "last_name_desc")
                                        {
                                            <i class="bi bi-sort-down-alt sort-icon"></i>
                                        }
                                        else if (ViewData["CurrentSort"]?.ToString() == "LastName")
                                        {
                                            <i class="bi bi-sort-up-alt sort-icon"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-filter sort-icon"></i>
                                        }
                                    </a>
                                </th>
                                <th style="min-width: 120px;">Date Of Birth</th>
                                <th style="min-width: 120px;">Phone</th>
                                <th style="min-width: 150px;">Email</th>
                                <th style="min-width: 120px;">Marital Status</th>
                                <th style="min-width: 150px;">Address</th>
                                <th style="min-width: 120px;">Birth Place</th>
                                <th class="actions-column">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="text-start">
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td data-label="First Name">
                                        <div class="text-truncate-cell" title="@item.FirstName">@item.FirstName</div>
                                    </td>
                                    <td data-label="Last Name">
                                        <div class="text-truncate-cell" title="@item.LastName">@item.LastName</div>
                                    </td>
                                    <td data-label="Date Of Birth">@(item.DateOfBirth.ToShortDateString() ?? "-")</td>
                                    <td data-label="Phone">@item.PhoneNumber</td>
                                    <td data-label="Email">
                                        <div class="text-truncate-cell" title="@item.Email">@item.Email</div>
                                    </td>
                                    <td data-label="Marital Status">@item.MartialStatus</td>
                                    <td data-label="Address">
                                        <div class="text-truncate-cell" title="@item.Address">@item.Address</div>
                                    </td>
                                    <td data-label="Birth Place">
                                        <div class="text-truncate-cell" title="@item.BirthPlace">@item.BirthPlace</div>
                                    </td>
                                    <td class="actions-column">
                                        <div class="btn-group btn-group-sm">
                                            <a class="btn btn-outline-secondary me-1" asp-action="Edit" asp-route-id="@item.Id" title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                                <span class="d-none d-md-inline">Edit</span>
                                            </a>
                                            <a class="btn btn-outline-info me-1" asp-action="Details" asp-route-id="@item.Id" title="Details">
                                                <i class="bi bi-info-circle"></i>
                                                <span class="d-none d-md-inline">Details</span>
                                            </a>
                                            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id" title="Delete">
                                                <i class="bi bi-trash"></i>
                                                <span class="d-none d-md-inline">Delete</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Pagination -->
    @{
        var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
        var nextDisabled = !Model.HasNextPage ? "disabled" : "";
    }
    <div class="d-flex justify-content-center align-items-center mt-3 gap-2">
        <a asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-currentFilter="@ViewData["CurrentFilter"]"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           class="btn btn-outline-secondary rounded-pill @prevDisabled">← Previous</a>
        <span class="px-2">Page @Model.PageIndex</span>
        <a asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-currentFilter="@ViewData["CurrentFilter"]"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           class="btn btn-outline-secondary rounded-pill @nextDisabled">Next →</a>
    </div>
</div>