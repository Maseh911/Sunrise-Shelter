@model PaginatedList<SunriseShelter.Areas.Identity.Data.SunriseShelterUser>

@{
    ViewData["Title"] = "Index";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<div class="container mt-4">
    <h1 class="text-center mb-4">Registered Parents</h1>

    <!-- REMOVED: Create button - Users should register through authentication system -->
    <!-- Search Bar -->
    <form asp-action="Index" method="get" class="d-flex justify-content-center mb-4">
        <div class="input-group shadow-sm" style="max-width: 600px;">
            <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]"
                   class="form-control border-start-0 rounded-end" placeholder="Find by name..." />
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-search"></i>
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center shadow-sm" role="alert">
            "@ViewData["CurrentFilter"]" was not found in the records.
        </div>
    }
    else
    {
        <!-- Table inside card -->
        <div class="card shadow-sm border-0 mx-auto">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-start">
                            <tr>
                                <th>
                                    <a asp-action="Index"
                                       asp-route-sortOrder="@ViewData["NameSortParm"]"
                                       class="text-decoration-none text-dark fw-bold">
                                        First Name
                                    </a>
                                </th>
                                <th>
                                    <a asp-action="Index"
                                       asp-route-sortOrder="@ViewData["LastNameSortParm"]"
                                       class="text-decoration-none text-dark fw-bold">
                                        Last Name
                                    </a>
                                </th>
                                <th>Date Of Birth</th>
                                <th>Phone</th>
                                <th>Email</th>
                                <th>Marital Status</th>
                                <th>Address</th>
                                <th>Birth Place</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody class="text-start">
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                                    <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                                    <td>@Html.DisplayFor(modelItem => item.DateOfBirth)</td>
                                    <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                                    <td>@Html.DisplayFor(modelItem => item.MartialStatus)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Address)</td>
                                    <td>@Html.DisplayFor(modelItem => item.BirthPlace)</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a class="btn btn-sm btn-outline-secondary me-1"
                                               asp-action="Edit" asp-route-id="@item.Id">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>
                                            <a class="btn btn-sm btn-outline-info me-1"
                                               asp-action="Details" asp-route-id="@item.Id">
                                                <i class="bi bi-info-circle"></i> Details
                                            </a>
                                            <a class="btn btn-sm btn-outline-danger"
                                               asp-action="Delete" asp-route-id="@item.Id">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Pagination -->
    @{
        var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
        var nextDisabled = !Model.HasNextPage ? "disabled" : "";
    }

    <div class="d-flex justify-content-center align-items-center mt-3 gap-2">

        <a asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           asp-route-currentFilter="@ViewData["CurrentFilter"]"
           class="btn btn-outline-secondary rounded-pill @prevDisabled">
            ← Previous
        </a>

        <span class="px-2">
            Page @Model.PageIndex
        </span>

        <a asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           asp-route-currentFilter="@ViewData["CurrentFilter"]"
           class="btn btn-outline-secondary rounded-pill @nextDisabled">
            Next →
        </a>
    </div>
</div>