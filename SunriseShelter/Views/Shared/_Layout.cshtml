<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sunrise Shelter</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SunriseShelter.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
<nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
    <div class="container-fluid">
        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"> 
            <img src ="~/Images/SunR.png" alt="Logo" style ="height:30px;" />
        </a>
        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index" style="color:white">Sunrise Shelter</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
            <ul class="navbar-nav nav-pills flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Orphanage" asp-action="Index">Orphanages</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Staff" asp-action="Index">Staff</a>
                        </li>

                        <!-- Only visible to Admins -->
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Adoption" asp-action="Index">Adoptions</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Parent" asp-action="Index">Parents</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Children" asp-action="Index">Childrens</a>
                            </li>
                        }
            </ul>
        </div>
    </div>
             <div>
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <footer class="bg-dark text-white mt-5 px-4 py-5">
        <div class="container bg-dark rounded-4 px-4 py-5">
            <div class="row">
                <!-- Left Column -->
                <div class="col-md-4 mb-4 mb-md-0">
                    <h5>Sunrise Shelter</h5>
                    <div class="d-flex gap-3">
                        <div class="bg-light rounded-circle d-flex justify-content-center align-items-center" style="width: 32px; height: 32px;">
                            <span class="text-dark fw-bold">A</span>
                        </div>
                        <div class="bg-light rounded-circle d-flex justify-content-center align-items-center" style="width: 32px; height: 32px;">
                            <span class="text-dark fw-bold">B</span>
                        </div>
                        <div class="bg-light rounded-circle d-flex justify-content-center align-items-center" style="width: 32px; height: 32px;">
                            <span class="text-dark fw-bold">C</span>
                        </div>
                        <div class="bg-light rounded-circle d-flex justify-content-center align-items-center" style="width: 32px; height: 32px;">
                            <span class="text-dark fw-bold">D</span>
                        </div>
                    </div>
                </div>

                <!-- Middle Column -->
                <div class="col-md-4 mb-4 mb-md-0">
                    <h6 class="mb-3">Extra links</h6>
                    <ul class="list-unstyled text-white" style="font-size: 0.9rem;">
                        <li><a href="#" class="text-white text-decoration-none">Home</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy" class="text-white text-decoration-none">Privacy Policy</a></li>
                        <li><a href="#" class="text-white text-decoration-none">Our team</a></li>
                        <li><a href="#" class="text-white text-decoration-none">About Us</a></li>
                    </ul>
                </div>

                <!-- Right Column -->
                <div class="col-md-4">
                    <h6 class="mb-3">Contact</h6>
                    <p class="text-white mb-1" style="font-size: 14px;">123 Example Road<br>New Zealand, Auckland 0001</p>
                    <p class="text-white mb-1" style="font-size: 14px;">Email: info@sunriseshelter.org</p>
                    <p class="text-white" style="font-size: 14px;">Phone: (555) 123-4567</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
