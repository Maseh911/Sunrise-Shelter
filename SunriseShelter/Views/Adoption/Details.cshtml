@model SunriseShelter.Models.Adoption // Strongly typed model for displaying adoption details

@{
    ViewData["Title"] = "Adoption Details"; // Sets the page title for layout and browser tab
}

<!-- Bootstrap Icons for visual enhancement -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-6">

            <!-- Card layout for displaying adoption info -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-4">
                    <h4 class="card-title mb-0 text-center text-dark">
                        <i class="bi bi-heart me-2"></i>Adoption Details
                    </h4>
                </div>
                <div class="card-body p-5">

                    <!-- Section for displaying adoption record fields -->
                    <div class="details-container bg-light rounded-3 p-4 mb-4">
                        <h5 class="text-center mb-4 text-muted">Adoption Information</h5>

                        <!-- Adoption Date -->
                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold text-dark">
                                <i class="bi bi-calendar-check me-2"></i>@Html.DisplayNameFor(model => model.AdoptionDate)
                            </div>
                            <div class="col-sm-8">
                                @Html.DisplayFor(model => model.AdoptionDate)
                            </div>
                        </div>

                        <!-- Application Date -->
                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold text-dark">
                                <i class="bi bi-calendar-event me-2"></i>@Html.DisplayNameFor(model => model.ApplicationDate)
                            </div>
                            <div class="col-sm-8">
                                @Html.DisplayFor(model => model.ApplicationDate)
                            </div>
                        </div>

                        <!-- Status -->
                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold text-dark">
                                <i class="bi bi-info-circle me-2"></i>@Html.DisplayNameFor(model => model.Status)
                            </div>
                            <div class="col-sm-8">
                                @Html.DisplayFor(model => model.Status)
                            </div>
                        </div>

                        <!-- Parent Name -->
                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold text-dark">
                                <i class="bi bi-person me-2"></i>@Html.DisplayNameFor(model => model.Parent)
                            </div>
                            <div class="col-sm-8">
                                @Html.DisplayFor(model => model.Parent.FirstName) @Html.DisplayFor(model => model.Parent.LastName)
                            </div>
                        </div>

                        <!-- Child Name and Birthplace -->
                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold text-dark">
                                <i class="bi bi-people me-2"></i>@Html.DisplayNameFor(model => model.Children)
                            </div>
                            <div class="col-sm-8">
                                @Html.DisplayFor(model => model.Children.Name)
                                <small class="text-muted d-block">(Born in: @Html.DisplayFor(model => model.Children.BirthPlace))</small>
                            </div>
                        </div>

                        <!-- Action buttons: Edit (admin only) and Back -->
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            @if (User.IsInRole("Admin")) // Only show Edit button for Admin users
                            {
                                <a asp-action="Edit" asp-route-id="@Model?.AdoptionId" class="btn btn-outline-primary rounded-pill px-4 py-2">
                                    <i class="bi bi-pencil-square me-2"></i>Edit
                                </a>
                            }
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                                <i class="bi bi-arrow-left me-2"></i>Back to List
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Custom styling for layout and spacing -->
    <style>
        .card {
            border-radius: 15px;
        }

        .card-header {
            border-top-left-radius: 15px !important;
            border-top-right-radius: 15px !important;
            border-bottom: 1px solid rgba(0,0,0,0.1);
        }

        .btn {
            font-size: 1.1rem;
            min-width: 140px;
        }

        .details-container {
            background-color: #f8f9fa !important;
        }

        .row {
            padding: 10px 0;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

            .row:last-child {
                border-bottom: none;
            }
    </style>
