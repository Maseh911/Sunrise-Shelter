@model SunriseShelter.Models.Adoption // Strongly typed model for the Adoption entity

@{
    ViewData["Title"] = "Delete"; // Sets the page title for layout and browser tab
}

<!-- Bootstrap Icons for visual enhancement -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-6">
            <!-- Card layout for delete confirmation -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-4">
                    <h4 class="card-title mb-0 text-center text-dark">
                        <i class="bi bi-trash me-2"></i>Delete Adoption
                    </h4>
                </div>
                <div class="card-body p-5">
                    <!-- Warning message before deletion -->
                    <div class="alert alert-warning text-center">
                        <h5><i class="bi bi-exclamation-triangle-fill me-2"></i>Are you sure you want to delete this adoption record?</h5>
                    </div>

                    <!-- Display key details of the adoption record -->
                    <div class="details-container bg-light rounded-3 p-4 mb-4">
                        <h5 class="text-center mb-4">Adoption Details</h5>

                        <!-- Display parent name -->
                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.Parent)</div>
                            <div class="col-sm-8">@Html.DisplayFor(m => m.Parent.FirstName) @Html.DisplayFor(m => m.Parent.LastName)</div>
                        </div>

                        <!-- Display child name -->
                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.Children)</div>
                            <div class="col-sm-8">@Html.DisplayFor(m => m.Children.Name) @Html.DisplayFor(m => m.Children.Name)</div>
                        </div>

                        <!-- Display adoption date -->
                        <div class="row">
                            <div class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.AdoptionDate)</div>
                            <div class="col-sm-8">@Html.DisplayFor(m => m.AdoptionDate)</div>
                        </div>
                    </div>

                    <!-- Form to confirm deletion -->
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="AdoptionId" /> <!-- Hidden field to pass the record ID -->
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <!-- Confirm deletion button -->
                            <button type="submit" class="btn btn-danger rounded-pill px-4 py-2">
                                <i class="bi bi-trash me-2"></i>Delete
                            </button>
                            <!-- Cancel and return to list -->
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                                <i class="bi bi-arrow-left me-2"></i>Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
