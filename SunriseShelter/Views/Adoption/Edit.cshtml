@model SunriseShelter.Models.Adoption // Strongly typed model for editing an adoption record

@{
    ViewData["Title"] = "Edit Adoption"; // Sets the page title for layout and browser tab
}

<!-- Bootstrap Icons for visual enhancement -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-6">
            <!-- Card layout for form container -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-4">
                    <h4 class="card-title mb-0 text-center text-dark">
                        <i class="bi bi-pencil-square me-2"></i>Edit Adoption
                    </h4>
                </div>
                <div class="card-body p-5">
                    <!-- Begin form for editing adoption -->
                    <form asp-action="Edit">
                        <!-- Display model-level validation errors -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Hidden fields to preserve original values -->
                        <input type="hidden" asp-for="AdoptionId" />         
                        <input type="hidden" asp-for="AdoptionDate" />      
                        <input type="hidden" asp-for="ApplicationDate" />   

                        <div class="row">
                            <!-- Display Adoption Date (read-only) -->
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-calendar-check me-2"></i>Adoption Date
                                </label>
                                <input value="@(Model.AdoptionDate?.ToString("yyyy-MM-dd") ?? "Not set")"
                                       class="form-control rounded-pill py-2 bg-light" readonly />
                                <small class="form-text text-muted">Cannot be edited</small>
                            </div>

                            <!-- Display Application Date (read-only) -->
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-calendar-event me-2"></i>Application Date
                                </label>
                                <input value="@Model.ApplicationDate.ToString("yyyy-MM-dd")"
                                       class="form-control rounded-pill py-2 bg-light" readonly />
                                <small class="form-text text-muted">Cannot be edited</small>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Status dropdown -->
                            <div class="col-12 mb-4">
                                <label asp-for="Status" class="form-label fw-bold">
                                    <i class="bi bi-info-circle me-2"></i>@Html.DisplayNameFor(model => model.Status)
                                </label>
                                <select asp-for="Status" class="form-control rounded-pill py-2">
                                    <option value="">Select Status</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Rejected">Rejected</option>
                                    <option value="Completed">Completed</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Parent selection dropdown -->
                            <div class="col-md-6 mb-4">
                                <label asp-for="ParentId" class="form-label fw-bold">
                                    <i class="bi bi-person me-2"></i>Parent
                                </label>
                                <select asp-for="ParentId" class="form-control rounded-pill py-2" asp-items="ViewBag.ParentId"></select>
                                <span asp-validation-for="ParentId" class="text-danger small"></span>
                            </div>

                            <!-- Child selection dropdown -->
                            <div class="col-md-6 mb-4">
                                <label asp-for="ChildrenId" class="form-label fw-bold">
                                    <i class="bi bi-people me-2"></i>Child
                                </label>
                                <select asp-for="ChildrenId" class="form-control rounded-pill py-2" asp-items="ViewBag.ChildrenId"></select>
                                <span asp-validation-for="ChildrenId" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Submit and Cancel buttons -->
                        <div class="form-group mt-5">
                            <div class="d-flex justify-content-center gap-3">
                                <button type="submit" class="btn btn-success rounded-pill px-4 py-2">
                                    <i class="bi bi-check-circle me-2"></i>Save Changes
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                                    <i class="bi bi-arrow-left me-2"></i>Back to List
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Client-side validation scripts -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<!-- Custom styling for form layout -->
<style>
    .card {
        border-radius: 15px;
    }

    .card-header {
        border-top-left-radius: 15px !important;
        border-top-right-radius: 15px !important;
        border-bottom: 1px solid rgba(0,0,0,0.1);
    }

    .form-control {
        font-size: 1.1rem;
        padding-left: 20px;
    }

    .btn {
        font-size: 1.1rem;
        min-width: 160px;
    }

    .form-label {
        font-size: 1.1rem;
        margin-bottom: 8px;
        padding-left: 10px;
        color: #333;
    }

    .alert-danger {
        border-radius: 12px;
    }

    select.form-control {
        height: calc(2.5rem + 2px);
    }

    .bg-light {
        background-color: #f8f9fa !important;
    }

    .form-text {
        padding-left: 15px;
        font-size: 0.9rem;
        color: #6c757d;
    }
</style>
