@model SunriseShelter.Models.Adoption

@{
    ViewData["Title"] = "Edit Adoption";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-6">
            <!-- Card Container -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-4">
                    <h4 class="card-title mb-0 text-center text-dark">
                        <i class="bi bi-pencil-square me-2"></i>Edit Adoption
                    </h4>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="AdoptionId" />

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="AdoptionDate" class="form-label fw-bold">
                                    <i class="bi bi-calendar-check me-2"></i>@Html.DisplayNameFor(model => model.AdoptionDate)
                                </label>
                                <input asp-for="AdoptionDate" class="form-control rounded-pill py-2" />
                                <span asp-validation-for="AdoptionDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="ApplicationDate" class="form-label fw-bold">
                                    <i class="bi bi-calendar-event me-2"></i>@Html.DisplayNameFor(model => model.ApplicationDate)
                                </label>
                                <input asp-for="ApplicationDate" class="form-control rounded-pill py-2" />
                                <span asp-validation-for="ApplicationDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 mb-4">
                                <label asp-for="Status" class="form-label fw-bold">
                                    <i class="bi bi-info-circle me-2"></i>@Html.DisplayNameFor(model => model.Status)
                                </label>
                                <input asp-for="Status" class="form-control rounded-pill py-2" placeholder="Enter adoption status" />
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="ParentId" class="form-label fw-bold">
                                    <i class="bi bi-person me-2"></i>@Html.DisplayNameFor(model => model.ParentId)
                                </label>
                                <select asp-for="ParentId" class="form-control rounded-pill py-2" asp-items="ViewBag.ParentId"></select>
                                <span asp-validation-for="ParentId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="ChildrenId" class="form-label fw-bold">
                                    <i class="bi bi-people me-2"></i>@Html.DisplayNameFor(model => model.ChildrenId)
                                </label>
                                <select asp-for="ChildrenId" class="form-control rounded-pill py-2" asp-items="ViewBag.ChildrenId"></select>
                                <span asp-validation-for="ChildrenId" class="text-danger small"></span>
                            </div>
                        </div>


                        <div class="form-group mt-5">
                            <div class="d-flex justify-content-center gap-3">
                                <button type="submit" class="btn btn-success rounded-pill px-4 py-2">
                                    <i class="bi bi-check-circle me-2"></i>Save Changes
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                                    <i class="bi bi-arrow-left me-2"></i>Back to List
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .card {
        border-radius: 15px;
    }

    .card-header {
        border-top-left-radius: 15px !important;
        border-top-right-radius: 15px !important;
        border-bottom: 1px solid rgba(0,0,0,0.1);
    }

    .form-control {
        font-size: 1.1rem;
        padding-left: 20px;
    }

    .btn {
        font-size: 1.1rem;
        min-width: 160px;
    }

    .form-label {
        font-size: 1.1rem;
        margin-bottom: 8px;
        padding-left: 10px;
        color: #333;
    }

    .alert-danger {
        border-radius: 12px;
    }

    select.form-control {
        height: calc(2.5rem + 2px);
    }
</style>
