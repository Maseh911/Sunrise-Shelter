@model PaginatedList<SunriseShelter.Models.Adoption>

@{
    ViewData["Title"] = "Adoptions";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<div class="container mt-4">
    <h1 class="text-center mb-4">Adoptions</h1>

    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex justify-content-center mb-3">
            <a class="btn btn-success rounded-pill px-4" asp-action="Create">
                <i class="bi bi-plus-lg"></i> Create New
            </a>
        </div>
    }

    <!-- Search -->
    <form asp-action="Index" method="get" class="d-flex justify-content-center mb-4">
        <div class="input-group shadow-sm" style="max-width: 600px;">
            <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]"
                   class="form-control border-start-0 rounded-end" placeholder="Find by parent or child..." />
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-search"></i>
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center shadow-sm">
            "@ViewData["CurrentFilter"]" was not found in records.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mx-auto" style="max-width: 1100px;">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-start">
                            <tr>
                                <th>Adoption Date</th>
                                <th>Application Date</th>
                                <th>Status</th>
                                <th>Parent</th>
                                <th>Child</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.AdoptionDate?.ToShortDateString()</td>
                                    <td>@item.ApplicationDate.ToShortDateString()</td>
                                    <td>@item.Status</td>
                                    <td>@item.Parent?.FirstName</td>
                                    <td>@item.Children?.Name</td>
                                    <td>
                                        <div class="btn-group">
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a class="btn btn-sm btn-outline-secondary me-1" asp-action="Edit" asp-route-id="@item.AdoptionId">
                                                    <i class="bi bi-pencil-square"></i> Edit
                                                </a>
                                            }
                                            <a class="btn btn-sm btn-outline-info me-1" asp-action="Details" asp-route-id="@item.AdoptionId">
                                                <i class="bi bi-info-circle"></i> Details
                                            </a>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.AdoptionId">
                                                    <i class="bi bi-trash"></i> Delete
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Pagination -->
    @{
        var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
        var nextDisabled = !Model.HasNextPage ? "disabled" : "";
    }
    <div class="d-flex justify-content-center align-items-center mt-3 gap-2">
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           class="btn btn-outline-secondary rounded-pill @prevDisabled">← Previous</a>
        <span class="px-2">Page @Model.PageIndex</span>
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           class="btn btn-outline-secondary rounded-pill @nextDisabled">Next →</a>
    </div>
</div>
