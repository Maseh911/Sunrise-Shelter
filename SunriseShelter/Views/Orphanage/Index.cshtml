@model PaginatedList<SunriseShelter.Models.Orphanage>

@{
    ViewData["Title"] = "Index";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<style>
    .sort-icon {
        margin-left: 5px;
        font-size: 0.9rem;
    }

    .sortable-header:hover {
        background-color: rgba(0, 0, 0, 0.05);
        border-radius: 4px;
        transition: background-color 0.2s ease;
    }
</style>

<div class="container mt-4">
    <h1 class="text-center mb-4">Orphanages</h1>

    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex justify-content-center mb-3">
            <a class="btn btn-success rounded-pill px-4" asp-action="Create">
                <i class="bi bi-plus-lg"></i> Create New
            </a>
        </div>
    }

    <!-- Search Bar -->
    <form asp-action="Index" method="get" class="d-flex justify-content-center mb-4">
        <div class="input-group shadow-sm" style="max-width: 600px;">
            <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]"
                   class="form-control border-start-0 rounded-end" placeholder="Find by name..." />
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-search"></i>
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center shadow-sm" role="alert">
            "@ViewData["CurrentFilter"]" was not found in the records.
        </div>
    }
    else
    {
        <!-- Table inside card -->
        <div class="card shadow-sm border-0 mx-auto" style="max-width: 1000px;">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-start">
                            <tr>
                                <th>
                                    <a asp-action="Index"
                                       asp-route-sortOrder="@ViewData["NameSortParm"]"
                                       asp-route-currentFilter="@ViewData["CurrentFilter"]"
                                       class="text-decoration-none text-dark fw-bold d-flex align-items-center sortable-header">
                                        Name
                                        @if (ViewData["CurrentSort"]?.ToString() == "name_desc")
                                        {
                                            <i class="bi bi-sort-down-alt sort-icon"></i>
                                        }
                                        else if (ViewData["CurrentSort"]?.ToString() == "name_asc" || ViewData["CurrentSort"]?.ToString() == "")
                                        {
                                            <i class="bi bi-sort-up-alt sort-icon"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-filter sort-icon"></i>
                                        }
                                    </a>
                                </th>
                                <th>Address</th>
                                <th>State</th>
                                <th>Country</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody class="text-start">
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Address)</td>
                                    <td>@Html.DisplayFor(modelItem => item.State)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Country)</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a class="btn btn-sm btn-outline-secondary me-1"
                                                   asp-action="Edit" asp-route-id="@item.OrphanageId">
                                                    <i class="bi bi-pencil-square"></i> Edit
                                                </a>
                                            }
                                            <a class="btn btn-sm btn-outline-info me-1"
                                               asp-action="Details" asp-route-id="@item.OrphanageId">
                                                <i class="bi bi-info-circle"></i> Details
                                            </a>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a class="btn btn-sm btn-outline-danger"
                                                   asp-action="Delete" asp-route-id="@item.OrphanageId">
                                                    <i class="bi bi-trash"></i> Delete
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Pagination -->
    @{
        var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
        var nextDisabled = !Model.HasNextPage ? "disabled" : "";
    }

    <div class="d-flex justify-content-center align-items-center mt-3 gap-2">
        <!-- Previous button -->
        <a asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-currentFilter="@ViewData["CurrentFilter"]"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           class="btn btn-outline-secondary rounded-pill @prevDisabled">
            ← Previous
        </a>

        <!-- Page numbers as text -->
        <span class="px-2">
            Page @Model.PageIndex
        </span>

        <!-- Next button -->
        <a asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-currentFilter="@ViewData["CurrentFilter"]"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           class="btn btn-outline-secondary rounded-pill @nextDisabled">
            Next →
        </a>
    </div>
</div>