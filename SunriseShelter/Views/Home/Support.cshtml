@{
    ViewData["Title"] = "Support Us";
}

<div class="container mt-4">
    <div class="support-header">
        <h1 class="fw-bold">Support Sunrise Shelter</h1>
    </div>

    <div class="section">
        <h2 class="fw-bold">Why Your Support Matters</h2>
        <p class="lead">
            Your generosity allows us to provide food, education, healthcare, and emotional care
            to children who need it most. Every contribution, no matter the size, makes a real difference.
        </p>
    </div>

    <div class="section bg-light">
        <h2 class="fw-bold">Ways You Can Help</h2>
        <ul class="lead">
            <li><strong>Donate:</strong> Help us cover daily essentials, school supplies, and medical needs.</li>
            <li><strong>Volunteer:</strong> Share your time and skills to create meaningful connections with our children.</li>
            <li><strong>Spread the Word:</strong> Share our mission with friends, family, and your community.</li>
        </ul>
    </div>

    <div class="section text-center">
        <a href="#" class="btn btn-success btn-lg">Donate Now</a>
        <p class="mt-2 text-muted">(Currently, this button does not link to a payment system.)</p>
    </div>
</div>

<style>
    .support-header {
        display: flex;
        align-items: center;
        justify-content: center;
        color: black;
        border-radius: 20px;
    }

    .section {
        padding: 60px 20px;
    }
</style>