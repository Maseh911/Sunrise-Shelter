@{
    ViewData["Title"] = "About Us";

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }

        .about-header {
            display: flex;
            align-items: center;
            justify-content: center;
            color: black;
            border-radius: 20px;
        }

        .section {
            padding: 60px 20px;
        }

    </style>
</head>
<body>
    <div class="container mt-4">
        <div class="about-header">
            <h1 class="fw-bold">About Sunrise Shelter</h1>
        </div>

        <div class="section">
            <h2 class="fw-bold">Who We Are</h2>
            <p class="lead">
                Sunrise Shelter is dedicated to providing care, love, and opportunities for children
                who have lost their families or come from vulnerable backgrounds.
            </p>
        </div>

        <div class="section bg-light">
            <h2 class="fw-bold">Our Vision & Mission</h2>
            <p class="lead">
                We envision a world where every child feels valued, safe, and hopeful for their future.
                Our mission is to nurture children with education, healthcare, and emotional support
                so they can grow into confident, responsible adults.
            </p>
        </div>

        <div class="section text-center">
            <a href="/Home/Support" class="btn btn-primary btn-lg">Support Us</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
