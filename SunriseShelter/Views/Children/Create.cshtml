@model SunriseShelter.Models.Children

@{
    ViewData["Title"] = "Add Child";
    var minBirthDate = DateTime.Today.AddYears(-17).AddDays(1).ToString("yyyy-MM-dd");
    var maxBirthDate = DateTime.Today.ToString("yyyy-MM-dd");
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-6">


            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-4">
                    <h4 class="card-title mb-0 text-center text-dark">
                        <i class="bi bi-heart me-2"></i>Add New Child
                    </h4>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-12 mb-4">
                                <label asp-for="Name" class="form-label fw-bold"></label>
                                <input asp-for="Name" class="form-control rounded-pill py-2" placeholder="Enter child's name" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Gender" class="form-label fw-bold"></label>
                                <select asp-for="Gender" class="form-control rounded-pill py-2">
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="DateOfBirth" class="form-label fw-bold"></label>
                                <input asp-for="DateOfBirth" type="date" class="form-control rounded-pill py-2"
                                       min="@minBirthDate"
                                       max="@maxBirthDate"
                                       oninvalid="this.setCustomValidity('Date of birth must be between 17 years ago and today.')"
                                       oninput="this.setCustomValidity('')" />
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                                <small class="form-text text-muted">Must be under 18 years old and cannot be in the future</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="BirthPlace" class="form-label fw-bold"></label>
                                <input asp-for="BirthPlace" class="form-control rounded-pill py-2" placeholder="Enter country of origin" />
                                <span asp-validation-for="BirthPlace" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="DateOfAdmission" class="form-label fw-bold"></label>
                                <input asp-for="DateOfAdmission" type="date" class="form-control rounded-pill py-2"
                                       max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       oninvalid="this.setCustomValidity('Date of admission cannot be in the future.')"
                                       oninput="this.setCustomValidity('')" />
                                <span asp-validation-for="DateOfAdmission" class="text-danger small"></span>
                                <small class="form-text text-muted">Cannot be in the future</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Status" class="form-label fw-bold"></label>
                                <select asp-for="Status" class="form-control rounded-pill py-2">
                                    <option value="">Select Status</option>
                                    <option value="Available">Available</option>
                                    <option value="In Process">In Process</option>
                                    <option value="Adopted">Adopted</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="OrphanageId" class="form-label fw-bold"></label>
                                <select asp-for="OrphanageId" class="form-control rounded-pill py-2" asp-items="ViewBag.OrphanageId">
                                    <option value="">Select Orphanage</option>
                                </select>
                                <span asp-validation-for="OrphanageId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group mt-5">
                            <div class="d-flex justify-content-center gap-3">
                                <button type="submit" class="btn btn-success rounded-pill px-4 py-2">
                                    <i class="bi bi-check-circle me-2"></i>Add Child
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                                    <i class="bi bi-arrow-left me-2"></i>Back to List
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .card {
        border-radius: 15px;
    }

    .card-header {
        border-top-left-radius: 15px !important;
        border-top-right-radius: 15px !important;
        border-bottom: 1px solid rgba(0,0,0,0.1);
    }

    .form-control {
        font-size: 1.1rem;
        padding-left: 20px;
    }

    .btn {
        font-size: 1.1rem;
        min-width: 140px;
    }

    .form-label {
        font-size: 1.1rem;
        margin-bottom: 8px;
        padding-left: 10px;
    }

    select.form-control {
        padding-left: 15px;
    }

    input[type="date"].form-control {
        padding-left: 15px;
    }

    .form-text {
        padding-left: 15px;
        font-size: 0.9rem;
        color: #6c757d;
    }