@model SunriseShelter.Models.Children

@{
    ViewData["Title"] = "Delete";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-4">
                    <h4 class="card-title mb-0 text-center text-dark">
                        <i class="bi bi-trash me-2"></i>Delete Child
                    </h4>
                </div>
                <div class="card-body p-5">
                    <div class="alert alert-warning text-center">
                        <h5><i class="bi bi-exclamation-triangle-fill me-2"></i>Are you sure you want to delete this child?</h5>
                    </div>

                    <div class="details-container bg-light rounded-3 p-4 mb-4">
                        <h5 class="text-center mb-4">Child Details</h5>

                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.Name)</div>
                            <div class="col-sm-8">@Html.DisplayFor(m => m.Name)</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.Gender)</div>
                            <div class="col-sm-8">@Html.DisplayFor(m => m.Gender)</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.DateOfBirth)</div>
                            <div class="col-sm-8">@Html.DisplayFor(m => m.DateOfBirth)</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.BirthPlace)</div>
                            <div class="col-sm-8">@Html.DisplayFor(m => m.BirthPlace)</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.DateOfAdmission)</div>
                            <div class="col-sm-8">@Html.DisplayFor(m => m.DateOfAdmission)</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.Status)</div>
                            <div class="col-sm-8">@Html.DisplayFor(m => m.Status)</div>
                        </div>

                        <div class="row">
                            <div class="col-sm-4 fw-bold">@Html.DisplayNameFor(m => m.Orphanage)</div>
                            <div class="col-sm-8">
                                @(Model.Orphanage != null
                                    ? Model.Orphanage.Name + " - " + Model.Orphanage.Name
                                    : "No Orphanage Assigned")
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="ChildrenId" />
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <button type="submit" class="btn btn-danger rounded-pill px-4 py-2">
                                <i class="bi bi-trash me-2"></i>Delete
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                                <i class="bi bi-arrow-left me-2"></i>Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
