@model PaginatedList<SunriseShelter.Models.Children>

@{
    ViewData["Title"] = "Children";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<style>
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .table th, .table td {
        white-space: nowrap;
        min-width: 120px;
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        padding: 12px 8px;
    }

    .table td {
        white-space: normal;
        word-wrap: break-word;
    }

    .actions-column {
        min-width: 250px;
        white-space: nowrap;
    }

    .btn-group .btn {
        white-space: nowrap;
    }
</style>

<div class="container mt-4">
    <h1 class="text-center mb-4">Children</h1>

    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex justify-content-center mb-3">
            <a class="btn btn-success rounded-pill px-4" asp-action="Create">
                <i class="bi bi-plus-lg"></i> Create New
            </a>
        </div>
    }

    @if (User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
    {
        <div class="d-flex justify-content-center mb-3">
            <a class="btn btn-success rounded-pill px-4" asp-controller="Adoption" asp-action="UserCreate">
                <i class="bi bi-heart-fill me-2"></i>Request Adoption
            </a>
        </div>
    }

    <!-- Search -->
    <form asp-action="Index" method="get" class="d-flex justify-content-center mb-4">
        <div class="input-group shadow-sm" style="max-width: 600px;">
            <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]"
                   class="form-control border-start-0 rounded-end" placeholder="Find by name..." />
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-search"></i>
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center shadow-sm">
            "@ViewData["CurrentFilter"]" was not found in records.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mx-auto" style="max-width: 1400px;">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-start">
                            <tr>
                                <th style="min-width: 150px;">Name</th>
                                <th style="min-width: 100px;">Gender</th>
                                <th style="min-width: 130px;">Date of Birth</th>
                                <th style="min-width: 150px;">Birth Place</th>
                                <th style="min-width: 150px;">Date of Admission</th>
                                <th style="min-width: 120px;">Status</th>
                                <th style="min-width: 180px;">Orphanage</th>
                                <th class="actions-column">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td data-label="Name" style="max-width: 150px;">
                                        <div class="text-truncate" title="@item.Name">@item.Name</div>
                                    </td>
                                    <td data-label="Gender" style="max-width: 100px;">@item.Gender</td>
                                    <td data-label="Date of Birth" style="max-width: 130px;">@item.DateOfBirth.ToShortDateString()</td>
                                    <td data-label="Birth Place" style="max-width: 150px;">
                                        <div class="text-truncate" title="@item.BirthPlace">@item.BirthPlace</div>
                                    </td>
                                    <td data-label="Date of Admission" style="max-width: 150px;">@item.DateOfAdmission.ToShortDateString()</td>
                                    <td data-label="Status" style="max-width: 120px;">@item.Status</td>
                                    <td data-label="Orphanage" style="max-width: 180px;">
                                        <div class="text-truncate" title="@item.Orphanage.Name">@item.Orphanage.Name</div>
                                    </td>
                                    <td class="actions-column">
                                        <div class="btn-group btn-group-sm">
                                            @if (User.Identity.IsAuthenticated && !User.IsInRole("Admin") && item.Status == "Available")
                                            {
                                                <a class="btn btn-sm btn-success me-1" asp-controller="Adoption" asp-action="UserCreate" asp-route-childrenId="@item.ChildrenId" title="Adopt">
                                                    <i class="bi bi-heart-fill"></i>
                                                    <span class="d-none d-md-inline">Adopt</span>
                                                </a>
                                            }
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a class="btn btn-outline-secondary me-1" asp-action="Edit" asp-route-id="@item.ChildrenId" title="Edit">
                                                    <i class="bi bi-pencil-square"></i>
                                                    <span class="d-none d-md-inline">Edit</span>
                                                </a>
                                            }
                                            <a class="btn btn-outline-info me-1" asp-action="Details" asp-route-id="@item.ChildrenId" title="Details">
                                                <i class="bi bi-info-circle"></i>
                                                <span class="d-none d-md-inline">Details</span>
                                            </a>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@item.ChildrenId" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                    <span class="d-none d-md-inline">Delete</span>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Pagination -->
    @{
        var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
        var nextDisabled = !Model.HasNextPage ? "disabled" : "";
    }
    <div class="d-flex justify-content-center align-items-center mt-3 gap-2">
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           class="btn btn-outline-secondary rounded-pill @prevDisabled">← Previous</a>
        <span class="px-2">Page @Model.PageIndex</span>
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           class="btn btn-outline-secondary rounded-pill @nextDisabled">Next →</a>
    </div>
</div>