@model PaginatedList<SunriseShelter.Models.Children>

@{
    ViewData["Title"] = "Children";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<style>
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        min-width: 100%;
    }

    .table th, .table td {
        padding: 12px 8px;
    }

    .actions-column {
        white-space: nowrap;
        min-width: 180px;
    }

    .btn-group .btn {
        white-space: nowrap;
        margin-right: 4px;
    }

    .text-truncate-cell {
        max-width: 150px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .card {
        width: 100%;
    }

    .sort-icon {
        margin-left: 5px;
        font-size: 0.9rem;
    }

    .sortable-header:hover {
        background-color: rgba(0, 0, 0, 0.05);
        border-radius: 4px;
        transition: background-color 0.2s ease;
    }
</style>

<div class="container mt-4">
    <h1 class="text-center mb-4">Children</h1>

    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex justify-content-center mb-3">
            <a class="btn btn-success rounded-pill px-4" asp-action="Create">
                <i class="bi bi-plus-lg"></i> Create New
            </a>
        </div>
    }

    @if (User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
    {
        <div class="d-flex justify-content-center mb-3">
            <a class="btn btn-success rounded-pill px-4" asp-controller="Adoption" asp-action="UserCreate">
                <i class="bi bi-heart-fill me-2"></i>Request Adoption
            </a>
        </div>
    }

    <!-- Search -->
    <form asp-action="Index" method="get" class="d-flex justify-content-center mb-4">
        <div class="input-group shadow-sm" style="max-width: 600px;">
            <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]"
                   class="form-control border-start-0 rounded-end" placeholder="Find by name..." />
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-search"></i>
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center shadow-sm">
            "@ViewData["CurrentFilter"]" was not found in records.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mx-auto" style="max-width: none;">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-start">
                            <tr>
                                <th style="min-width: 150px;">
                                    <a asp-action="Index"
                                       asp-route-sortOrder="@ViewData["NameSortParm"]"
                                       asp-route-currentFilter="@ViewData["CurrentFilter"]"
                                       asp-route-pageNumber="@Model.PageIndex"
                                       class="text-decoration-none text-dark fw-bold d-flex align-items-center sortable-header">
                                        Name
                                        @if (ViewData["CurrentSort"]?.ToString() == "name_desc")
                                        {
                                            <i class="bi bi-sort-down-alt sort-icon"></i>
                                        }
                                        else if (ViewData["CurrentSort"]?.ToString() == "name_asc" || ViewData["CurrentSort"]?.ToString() == "")
                                        {
                                            <i class="bi bi-sort-up-alt sort-icon"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-filter sort-icon"></i>
                                        }
                                    </a>
                                </th>
                                <th style="min-width: 80px;">Gender</th>
                                <th style="min-width: 120px;">
                                    <a asp-action="Index"
                                       asp-route-sortOrder="@ViewData["DateSortParm"]"
                                       asp-route-currentFilter="@ViewData["CurrentFilter"]"
                                       asp-route-pageNumber="@Model.PageIndex"
                                       class="text-decoration-none text-dark fw-bold d-flex align-items-center sortable-header">
                                        Date of Birth
                                        @if (ViewData["CurrentSort"]?.ToString() == "date_desc")
                                        {
                                            <i class="bi bi-sort-down-alt sort-icon"></i>
                                        }
                                        else if (ViewData["CurrentSort"]?.ToString() == "date_asc")
                                        {
                                            <i class="bi bi-sort-up-alt sort-icon"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-filter sort-icon"></i>
                                        }
                                    </a>
                                </th>
                                <th style="min-width: 120px;">Birth Place</th>
                                <th style="min-width: 120px;">Date of Admission</th>
                                <th style="min-width: 100px;">Status</th>
                                <th style="min-width: 150px;">Orphanage</th>
                                <th class="actions-column">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td data-label="Name">
                                        <div class="text-truncate-cell" title="@item.Name">@item.Name</div>
                                    </td>
                                    <td data-label="Gender">@item.Gender</td>
                                    <td data-label="Date of Birth">@item.DateOfBirth.ToShortDateString()</td>
                                    <td data-label="Birth Place">
                                        <div class="text-truncate-cell" title="@item.BirthPlace">@item.BirthPlace</div>
                                    </td>
                                    <td data-label="Date of Admission">@item.DateOfAdmission.ToShortDateString()</td>
                                    <td data-label="Status">@item.Status</td>
                                    <td data-label="Orphanage">
                                        <div class="text-truncate-cell" title="@item.Orphanage.Name">@item.Orphanage.Name</div>
                                    </td>
                                    <td class="actions-column">
                                        <div class="btn-group btn-group-sm">
                                            @if (User.Identity.IsAuthenticated && !User.IsInRole("Admin") && item.Status == "Available")
                                            {
                                                <a class="btn btn-sm btn-success me-1" asp-controller="Adoption" asp-action="UserCreate" asp-route-childrenId="@item.ChildrenId" title="Adopt">
                                                    <i class="bi bi-heart-fill"></i>
                                                    <span class="d-none d-md-inline">Adopt</span>
                                                </a>
                                            }
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a class="btn btn-outline-secondary me-1" asp-action="Edit" asp-route-id="@item.ChildrenId" title="Edit">
                                                    <i class="bi bi-pencil-square"></i>
                                                    <span class="d-none d-md-inline">Edit</span>
                                                </a>
                                            }
                                            <a class="btn btn-outline-info me-1" asp-action="Details" asp-route-id="@item.ChildrenId" title="Details">
                                                <i class="bi bi-info-circle"></i>
                                                <span class="d-none d-md-inline">Details</span>
                                            </a>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@item.ChildrenId" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                    <span class="d-none d-md-inline">Delete</span>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Pagination -->
    @{
        var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
        var nextDisabled = !Model.HasNextPage ? "disabled" : "";
    }
    <div class="d-flex justify-content-center align-items-center mt-3 gap-2">
        <a asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-currentFilter="@ViewData["CurrentFilter"]"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           class="btn btn-outline-secondary rounded-pill @prevDisabled">← Previous</a>
        <span class="px-2">Page @Model.PageIndex</span>
        <a asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-currentFilter="@ViewData["CurrentFilter"]"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           class="btn btn-outline-secondary rounded-pill @nextDisabled">Next →</a>
    </div>
</div>